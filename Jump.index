<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sunny LEGO Run - Endless Runner</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #87CEEB;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #2d3748;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #game-container {
            position: relative;
            width: 100%;
            max-width: 480px;
            height: 100%;
            max-height: 850px;
            background: linear-gradient(180deg, #87CEEB 0%, #e0f7ff 100%);
            overflow: hidden;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 24px;
            background: rgba(135, 206, 235, 0.9);
            backdrop-filter: blur(8px);
            z-index: 10;
            transition: opacity 0.3s ease;
        }
        .screen.hidden {
            opacity: 0;
            pointer-events: none;
            display: none !important;
        }
        h1 {
            font-size: 2.8rem;
            margin: 0 0 8px 0;
            color: #d69e2e;
            text-align: center;
            font-weight: 900;
            letter-spacing: 2px;
            text-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
        }
        p.subtitle {
            font-size: 1rem;
            color: #4a5568;
            margin-bottom: 32px;
            text-align: center;
            font-weight: 600;
        }
        input[type="text"] {
            width: 80%;
            max-width: 280px;
            padding: 16px;
            font-size: 1.1rem;
            border-radius: 16px;
            border: 2px solid #3182ce;
            background: rgba(255, 255, 255, 0.9);
            color: #2d3748;
            outline: none;
            text-align: center;
            margin-bottom: 20px;
            transition: all 0.3s;
        }
        input[type="text"]:focus {
            border-color: #d69e2e;
            box-shadow: 0 0 15px rgba(214, 158, 46, 0.4);
        }
        button {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
            color: white;
            border: none;
            padding: 16px 48px;
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 16px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(56, 161, 105, 0.4);
            transition: transform 0.1s, box-shadow 0.1s;
            letter-spacing: 1px;
        }
        button:active {
            transform: scale(0.95);
            box-shadow: 0 2px 10px rgba(56, 161, 105, 0.4);
        }
        .stats-card {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 16px;
            padding: 20px;
            width: 80%;
            max-width: 280px;
            text-align: center;
            margin-bottom: 24px;
        }
        .stats-card div {
            font-size: 0.9rem;
            color: #718096;
            margin-bottom: 6px;
            font-weight: bold;
        }
        .stats-card span {
            font-size: 1.8rem;
            font-weight: bold;
            color: #3182ce;
        }
        #hud {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 5;
            pointer-events: none;
            font-weight: bold;
            font-size: 1.1rem;
            color: #2d3748;
            text-shadow: 0 1px 2px rgba(255,255,255,0.8);
        }
        .hud-item {
            background: rgba(255, 255, 255, 0.85);
            padding: 8px 16px;
            border-radius: 12px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(4px);
        }
    </style>
</head>
<body>
    <div id="game-container">
        <!-- HUD -->
        <div id="hud">
            <div class="hud-item" id="hud-name">Player</div>
            <div class="hud-item" id="hud-score">Score: 0</div>
        </div>

        <!-- Canvas Game Renderer -->
        <canvas id="gameCanvas"></canvas>

        <!-- Title Screen -->
        <div id="title-screen" class="screen">
            <h1>SUNNY RUN</h1>
            <p class="subtitle">Jump over bushes & duck under planes!</p>
            <input type="text" id="player-name-input" placeholder="Enter your first name" maxlength="12">
            <button id="play-btn">PLAY</button>
        </div>

        <!-- Game Over Screen -->
        <div id="gameover-screen" class="screen hidden">
            <h1>GAME OVER</h1>
            <p class="subtitle" id="gameover-msg">Nice try!</p>
            <div class="stats-card">
                <div>FINAL SCORE</div>
                <span id="final-score">0</span>
            </div>
            <div class="stats-card" style="margin-top: -12px; margin-bottom: 24px;">
                <div>BEST SCORE</div>
                <span id="best-score" style="color: #e53e3e;">0</span>
            </div>
            <button id="restart-btn">PLAY AGAIN</button>
        </div>
    </div>

    <script>
        let audioCtx = null;
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playSound(type) {
            if (!audioCtx) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                const now = audioCtx.currentTime;

                if (type === 'jump') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(150, now);
                    osc.frequency.exponentialRampToValueAtTime(450, now + 0.15);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
                    osc.start(now);
                    osc.stop(now + 0.15);
                } else if (type === 'slide') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(250, now);
                    osc.frequency.exponentialRampToValueAtTime(100, now + 0.12);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.12);
                    osc.start(now);
                    osc.stop(now + 0.12);
                } else if (type === 'hit') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(120, now);
                    osc.frequency.linearRampToValueAtTime(30, now + 0.3);
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                }
            } catch (e) {
                console.error(e);
            }
        }

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const titleScreen = document.getElementById('title-screen');
        const gameOverScreen = document.getElementById('gameover-screen');
        const playBtn = document.getElementById('play-btn');
        const restartBtn = document.getElementById('restart-btn');
        const nameInput = document.getElementById('player-name-input');
        const hudName = document.getElementById('hud-name');
        const hudScore = document.getElementById('hud-score');
        const finalScoreEl = document.getElementById('final-score');
        const bestScoreEl = document.getElementById('best-score');
        const gameOverMsg = document.getElementById('gameover-msg');

        let width = 480, height = 800;
        function resize() {
            const container = document.getElementById('game-container');
            width = container.clientWidth || 480;
            height = container.clientHeight || 800;
            canvas.width = width * window.devicePixelRatio;
            canvas.height = height * window.devicePixelRatio;
            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
        }
        window.addEventListener('resize', resize);
        resize();

        let gameState = 'TITLE';
        let score = 0;
        let floatingScore = 0;
        let bestScore = localStorage.getItem('sunny_lego_best') || 0;
        let playerName = 'Player';
        let gameSpeed = 5;
        let baseSpeed = 5;
        let speedMultiplier = 1;
        let spawnTimer = 0;
        let spawnInterval = 90;
        let groundY = height - 120;

        let player = {
            x: 60,
            y: 0,
            w: 36,
            h: 60,
            vy: 0,
            jumpForce: -13,
            gravity: 0.6,
            isJumping: false,
            isSliding: false,
            slideTimer: 0,
            normalH: 60,
            slideH: 30
        };

        let obstacles = [];
        let particles = [];
        let clouds = [];

        for (let i = 0; i < 5; i++) {
            clouds.push({
                x: Math.random() * width,
                y: Math.random() * (height * 0.4),
                size: Math.random() * 40 + 40,
                speed: Math.random() * 0.3 + 0.1
            });
        }

        function resetGame() {
            resize();
            groundY = height - 120;
            score = 0;
            floatingScore = 0;
            gameSpeed = baseSpeed;
            speedMultiplier = 1;
            spawnTimer = 0;
            spawnInterval = 90;
            obstacles = [];
            particles = [];
            player.y = groundY - player.h;
            player.vy = 0;
            player.isJumping = false;
            player.isSliding = false;
            player.slideTimer = 0;
            player.h = player.normalH;
        }

        let touchStartY = 0;
        let touchStartX = 0;

        window.addEventListener('keydown', (e) => {
            if (gameState !== 'PLAYING') return;
            initAudio();
            if (e.code === 'Space' || e.code === 'ArrowUp') {
                e.preventDefault();
                playerJump();
            } else if (e.code === 'ArrowDown' || e.code === 'KeyS') {
                e.preventDefault();
                playerSlide();
            }
        });

        canvas.addEventListener('touchstart', (e) => {
            if (gameState !== 'PLAYING') return;
            initAudio();
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        }, {passive: true});

        canvas.addEventListener('touchend', (e) => {
            if (gameState !== 'PLAYING') return;
            let touchEndX = e.changedTouches[0].clientX;
            let touchEndY = e.changedTouches[0].clientY;
            let diffX = touchEndX - touchStartX;
            let diffY = touchEndY - touchStartY;

            if (Math.abs(diffY) > Math.abs(diffX)) {
                if (diffY < -30) {
                    playerJump();
                } else if (diffY > 30) {
                    playerSlide();
                }
            } else {
                playerJump();
            }
        }, {passive: true});

        canvas.addEventListener('click', () => {
            if (gameState === 'PLAYING') {
                initAudio();
                playerJump();
            }
        });

        function playerJump() {
            if (!player.isJumping && !player.isSliding) {
                player.vy = player.jumpForce;
                player.isJumping = true;
                playSound('jump');
                createParticles(player.x + player.w / 2, groundY, '#48bb78', 8);
            } else if (player.isSliding) {
                player.isSliding = false;
                player.h = player.normalH;
                player.y = groundY - player.h;
                player.vy = player.jumpForce;
                player.isJumping = true;
                playSound('jump');
            }
        }

        function playerSlide() {
            if (!player.isJumping && !player.isSliding) {
                player.isSliding = true;
                player.h = player.slideH;
                player.y = groundY - player.h;
                player.slideTimer = 45;
                playSound('slide');
                createParticles(player.x + player.w / 2, groundY, '#3182ce', 8);
            }
        }

        function createParticles(x, y, color, count) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 6,
                    vy: (Math.random() - 0.5) * 6,
                    size: Math.random() * 5 + 2,
                    alpha: 1,
                    color: color
                });
            }
        }

        function spawnObstacle() {
            // Type 0 = Bush on ground (jump over), Type 1 = Plane in the air (duck/slide under)
            let type = Math.random() > 0.4 ? 0 : 1;
            let obs = {
                x: width + 50,
                w: type === 0 ? 44 : 70,
                h: type === 0 ? 40 : 30,
                y: type === 0 ? 0 : (groundY - 110 - Math.random() * 20),
                type: type
            };
            if (obs.type === 0) {
                obs.y = groundY - obs.h;
            }
            obstacles.push(obs);
        }

        playBtn.addEventListener('click', () => {
            initAudio();
            let val = nameInput.value.trim();
            playerName = val ? val : 'Player';
            hudName.textContent = playerName;
            titleScreen.classList.add('hidden');
            resetGame();
            gameState = 'PLAYING';
        });

        restartBtn.addEventListener('click', () => {
            initAudio();
            gameOverScreen.classList.add('hidden');
            resetGame();
            gameState = 'PLAYING';
        });

        function update() {
            if (gameState !== 'PLAYING') return;

            groundY = height - 120;
            speedMultiplier += 0.0007;
            gameSpeed = baseSpeed * speedMultiplier;
            
            floatingScore += gameSpeed * 0.1;
            score = Math.floor(floatingScore);
            hudScore.textContent = `Score: ${score}`;

            if (player.isJumping) {
                player.vy += player.gravity;
                player.y += player.vy;
                if (player.y >= groundY - player.h) {
                    player.y = groundY - player.h;
                    player.isJumping = false;
                    player.vy = 0;
                }
            } else if (player.isSliding) {
                player.slideTimer--;
                if (player.slideTimer <= 0) {
                    player.isSliding = false;
                    player.h = player.normalH;
                    player.y = groundY - player.h;
                }
            } else {
                player.y = groundY - player.h;
            }

            spawnTimer++;
            if (spawnTimer >= Math.max(35, spawnInterval - Math.floor(speedMultiplier * 15))) {
                spawnObstacle();
                spawnTimer = 0;
            }

            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.x -= gameSpeed;

                if (
                    player.x < obs.x + obs.w &&
                    player.x + player.w > obs.x &&
                    player.y < obs.y + obs.h &&
                    player.y + player.h > obs.y
                ) {
                    playSound('hit');
                    createParticles(player.x + player.w / 2, player.y + player.h / 2, '#e53e3e', 25);
                    gameState = 'GAMEOVER';
                    
                    if (score > bestScore) {
                        bestScore = score;
                        localStorage.setItem('sunny_lego_best', bestScore);
                    }
                    
                    finalScoreEl.textContent = score;
                    bestScoreEl.textContent = bestScore;
                    gameOverMsg.textContent = `Great run, ${playerName}!`;
                    gameOverScreen.classList.remove('hidden');
                }

                if (obs.x + obs.w < 0) {
                    obstacles.splice(i, 1);
                }
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= 0.03;
                if (p.alpha <= 0) {
                    particles.splice(i, 1);
                }
            }

            for (let c of clouds) {
                c.x -= c.speed * (gameSpeed * 0.2);
                if (c.x < -100) c.x = width + 100;
            }
        }

        function drawLegoPerson(x, y, w, h, isSliding) {
            ctx.save();
            if (isSliding) {
                // Sliding / Ducking pose
                // Torso / body horizontal
                ctx.fillStyle = '#3182ce'; // Blue shirt
                ctx.fillRect(x, y + 10, w - 10, 20);
                
                // Head
                ctx.fillStyle = '#ecc94b'; // Yellow head
                ctx.beginPath();
                ctx.arc(x + w - 10, y + 20, 10, 0, Math.PI * 2);
                ctx.fill();
                // Stud on head
                ctx.fillStyle = '#b7791f';
                ctx.fillRect(x + w - 14, y + 8, 8, 3);
            } else {
                // Running / Standing pose
                // Legs
                ctx.fillStyle = '#2d3748';
                ctx.fillRect(x + 6, y + 36, 9, 24);
                ctx.fillRect(x + 21, y + 36, 9, 24);

                // Torso (brick shape)
                ctx.fillStyle = '#e53e3e'; // Red LEGO shirt
                ctx.fillRect(x + 4, y + 16, 28, 22);

                // Yellow LEGO Head
                ctx.fillStyle = '#ecc94b';
                ctx.beginPath();
                ctx.arc(x + 18, y + 8, 11, 0, Math.PI * 2);
                ctx.fill();

                // Head stud
                ctx.fillStyle = '#b7791f';
                ctx.fillRect(x + 13, y - 5, 10, 4);

                // Simple face smile
                ctx.strokeStyle = '#2d3748';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(x + 18, y + 8, 5, 0.1 * Math.PI, 0.9 * Math.PI);
                ctx.stroke();
            }
            ctx.restore();
        }

        function draw() {
            ctx.clearRect(0, 0, width, height);

            // Draw Sun in sky
            ctx.fillStyle = '#f6e05e';
            ctx.beginPath();
            ctx.arc(width - 60, 70, 35, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
            ctx.beginPath();
            ctx.arc(width - 60, 70, 45, 0, Math.PI * 2);
            ctx.fill();

            // Draw Clouds
            ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
            for (let c of clouds) {
                ctx.beginPath();
                ctx.arc(c.x, c.y, c.size * 0.5, 0, Math.PI * 2);
                ctx.arc(c.x + c.size * 0.4, c.y - c.size * 0.2, c.size * 0.4, 0, Math.PI * 2);
                ctx.arc(c.x + c.size * 0.8, c.y, c.size * 0.45, 0, Math.PI * 2);
                ctx.fill();
            }

            // Draw Grass Ground
            ctx.fillStyle = '#48bb78';
            ctx.fillRect(0, groundY, width, height - groundY);
            ctx.fillStyle = '#38a169';
            ctx.fillRect(0, groundY, width, 12);

            // Draw Obstacles (Bushes and Planes)
            for (let obs of obstacles) {
                if (obs.type === 0) {
                    // Bush (Jump over)
                    ctx.fillStyle = '#2f855a';
                    ctx.beginPath();
                    ctx.arc(obs.x + obs.w * 0.3, obs.y + obs.h * 0.5, obs.w * 0.4, 0, Math.PI * 2);
                    ctx.arc(obs.x + obs.w * 0.7, obs.y + obs.h * 0.4, obs.w * 0.45, 0, Math.PI * 2);
                    ctx.fill();
                    // Bush flowers / detail
                    ctx.fillStyle = '#feb2b2';
                    ctx.beginPath();
                    ctx.arc(obs.x + obs.w * 0.5, obs.y + obs.h * 0.3, 4, 0, Math.PI * 2);
                    ctx.fill();
                } else {
                    // Plane (Duck / Slide under)
                    ctx.save();
                    ctx.fillStyle = '#edf2f7';
                    ctx.beginPath();
                    ctx.ellipse(obs.x + obs.w/2, obs.y + obs.h/2, obs.w/2, obs.h/3, 0, 0, Math.PI * 2);
                    ctx.fill();
                    // Wings
                    ctx.fillStyle = '#cbd5e0';
                    ctx.fillRect(obs.x + obs.w * 0.3, obs.y - 6, 12, obs.h + 12);
                    // Propeller / nose
                    ctx.fillStyle = '#e53e3e';
                    ctx.fillRect(obs.x + obs.w - 6, obs.y + 6, 6, 18);
                    ctx.restore();
                }
            }

            // Draw LEGO Player Character
            drawLegoPerson(player.x, player.y, player.w, player.h, player.isSliding);

            // Draw Particles
            for (let p of particles) {
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.alpha;
                ctx.fillRect(p.x, p.y, p.size, p.size);
            }
            ctx.globalAlpha = 1.0;
        }

        function loop() {
            update();
            draw();
            requestAnimationFrame(loop);
        }

        requestAnimationFrame(loop);
    </script>
</body>
</html>
